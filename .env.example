# Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=linnworks_sync
DB_USER=root
DB_PASSWORD=your_password_here
DB_CHARSET=utf8mb4

# Mode: 'live' or 'fixture'
LW_MODE=fixture

# US Instance Credentials
LW_US_APP_ID=
LW_US_APP_SECRET=
LW_US_TOKEN=

# CA Instance Credentials
LW_CA_APP_ID=
LW_CA_APP_SECRET=
LW_CA_TOKEN=

# Required for v2 orders: configure each account's verified hosting origin.
# Allowed origins: https://eu-api.linnworks.net or https://us-api.linnworks.net
# Business region US/CA does not determine the account's hosting region.
LW_US_API_BASE_URL=
LW_CA_API_BASE_URL=

# Global Fallback Credentials (if single app is used)
LW_APP_ID=
LW_APP_SECRET=

# Rate limiting & Retries
LW_RATE_LIMIT_RPS=2.0
# Conservative v2 order pacing: one request every two seconds per account.
LW_ORDERS_RATE_LIMIT_RPS=0.5
# Minimum cooldown for HTTP 429 when Retry-After is missing or invalid.
LW_RATE_LIMIT_COOLDOWN=60
LW_REQUEST_TIMEOUT=30
LW_MAX_RETRIES=3
LW_RETRY_BACKOFF=1.5

# Logging. Production: LW_LOG_DIR=/home/ubuntu/lwsync-logs (one <job>.log per job, rotated by logrotate).
LW_LOG_DIR=logs
LW_LOG_LEVEL=INFO
LW_LOG_TO_FILE=true
# Keep console output even when not run from a terminal (normally off under cron).
# LW_LOG_CONSOLE=false
# API calls slower than this many seconds are logged as warnings.
LW_SLOW_REQUEST_SECONDS=10

# Database timeouts (seconds) and extra attempts after a temporary DB error.
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=120
DB_WRITE_TIMEOUT=120
DB_WRITE_RETRIES=2

# `python -m lwsync health`: unhealthy when the last success is older than this (minutes).
LW_HEALTH_ORDERS_MAX_AGE_MIN=45
LW_HEALTH_CATALOG_MAX_AGE_MIN=300

# =============================================================================
# Legacy draft pipeline settings (not used by Deliverable 2 FileSettings)
# =============================================================================

# SFTP / Local directory root (default: data/sftp inside the project)
# 3PL_SFTP_ROOT=data/sftp
# 3PL_LINNWORKS_EXPORT_DIR=data/sftp/linnworks/orders
# 3PL_US_INBOUND_DIR=data/sftp/3pl_us/inbound_orders
# 3PL_CA_INBOUND_DIR=data/sftp/3pl_ca/inbound_orders
# 3PL_ARCHIVE_DIR=data/sftp/archive
# 3PL_FAILED_DIR=data/sftp/failed

# 3PL Warehouse Location GUIDs (Defaults: US | AJC and CA | AJC)
# 3PL_US_LOCATION_ID=4d5833b6-a649-4d81-b572-da15682797ef
# 3PL_CA_LOCATION_ID=faaab11f-76e5-469f-b105-d9472408f85c

# The 4 Primary-Substitute SKU Pairs & Thresholds (Defaults shown below)
# SKU_PAIR_1_PRIMARY=PRIMARY-SKU-001
# SKU_PAIR_1_SUB=SUB-SKU-001
# SKU_PAIR_1_THRESHOLD=20
# SKU_PAIR_2_PRIMARY=PRIMARY-SKU-002
# SKU_PAIR_2_SUB=SUB-SKU-002
# SKU_PAIR_2_THRESHOLD=30
# SKU_PAIR_3_PRIMARY=PRIMARY-SKU-003
# SKU_PAIR_3_SUB=SUB-SKU-003
# SKU_PAIR_3_THRESHOLD=50
# SKU_PAIR_4_PRIMARY=PRIMARY-SKU-004
# SKU_PAIR_4_SUB=SUB-SKU-004
# SKU_PAIR_4_THRESHOLD=20

# Email Alerts (AWS SES) for Parked Orders and Pipeline Errors
# 3PL_ENABLE_EMAIL_ALERTS=false
# AWS_SES_REGION=us-east-1
# 3PL_ALERT_EMAIL_FROM=alerts@batteryclerk.com
# 3PL_ALERT_EMAIL_TO=operations@batteryclerk.com

# GI file layer (Deliverable 2). No production pipeline CLI is enabled yet.
# Settings never create folders on import. Confirm held/error paths first.
LW_PIPELINE_US_INPUT_DIR=/data/us/new_orders
LW_PIPELINE_US_OUTPUT_DIR=/data/us/orders
LW_PIPELINE_US_ARCHIVE_DIR=/data/us/archive
LW_PIPELINE_US_TEMP_DIR=/data/us/.pipeline_tmp
LW_PIPELINE_US_HELD_DIR=
LW_PIPELINE_US_ERROR_DIR=
LW_PIPELINE_CA_INPUT_DIR=/data/ca/new_orders
LW_PIPELINE_CA_OUTPUT_DIR=/data/ca/orders
LW_PIPELINE_CA_ARCHIVE_DIR=/data/ca/archive
LW_PIPELINE_CA_TEMP_DIR=/data/ca/.pipeline_tmp
LW_PIPELINE_CA_HELD_DIR=
LW_PIPELINE_CA_ERROR_DIR=
LW_PIPELINE_LOCK_FILE=/run/lock/lwsync-pipeline.lock
LW_PIPELINE_STABLE_SECONDS=60

