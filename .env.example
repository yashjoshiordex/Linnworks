# Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=linnworks_sync
DB_USER=root
DB_PASSWORD=your_password_here
DB_CHARSET=utf8mb4

# Mode: 'live' or 'fixture'
LW_MODE=fixture

# Table prefix
LW_TABLE_PREFIX=lw_

# US Instance Credentials
LW_US_APP_ID=
LW_US_APP_SECRET=
LW_US_TOKEN=

# CA Instance Credentials
LW_CA_APP_ID=
LW_CA_APP_SECRET=
LW_CA_TOKEN=

# Global Fallback Credentials (if single app is used)
LW_APP_ID=
LW_APP_SECRET=

# Rate limiting & Retries
LW_RATE_LIMIT_RPS=2.0
LW_REQUEST_TIMEOUT=30
LW_MAX_RETRIES=3
LW_RETRY_BACKOFF=1.5
